# Copiez ce fichier vers backend/.env puis complétez les valeurs

DJANGO_SECRET_KEY=changez-cette-cle-secrete-en-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Moteur de base de données : sqlite | postgresql | mysql
DB_ENGINE=sqlite
DB_NAME=encheres_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
